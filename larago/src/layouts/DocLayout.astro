---
import Sidebar from '../components/Sidebar.astro';
import '../styles/global.css';

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | LaraGo</title>
    <meta name="description" content="De Laravel a Go con la stdlib" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <div class="flex min-h-screen">
      <!-- Desktop sidebar -->
      <aside
        id="sidebar"
        class="fixed inset-y-0 left-0 z-30 hidden w-72 shrink-0 border-r border-sidebar-border bg-sidebar md:block"
      >
        <div class="flex h-14 items-center gap-2 border-b border-sidebar-border px-5">
          <a href="/" class="text-lg font-bold tracking-tight">
            Lara<span class="text-primary">Go</span>
          </a>
        </div>
        <div class="h-[calc(100vh-3.5rem)] overflow-y-auto p-4">
          <Sidebar currentUrl={Astro.url.pathname} />
        </div>
      </aside>

      <!-- Mobile sidebar overlay -->
      <div
        id="sidebar-overlay"
        class="fixed inset-0 z-20 hidden bg-black/50 md:hidden"
        onclick="closeSidebar()"
      ></div>
      <aside
        id="mobile-sidebar"
        class="fixed inset-y-0 left-0 z-30 w-72 -translate-x-full border-r border-sidebar-border bg-sidebar transition-transform md:hidden"
      >
        <div class="flex h-14 items-center gap-2 border-b border-sidebar-border px-5">
          <a href="/" class="text-lg font-bold tracking-tight">
            Lara<span class="text-primary">Go</span>
          </a>
        </div>
        <div class="h-[calc(100vh-3.5rem)] overflow-y-auto p-4">
          <Sidebar currentUrl={Astro.url.pathname} />
        </div>
      </aside>

      <!-- Main content area -->
      <div class="flex min-h-screen flex-1 flex-col md:ml-72">
        <!-- Top bar -->
        <header class="sticky top-0 z-10 flex h-14 items-center gap-4 border-b border-border bg-background/95 px-4 backdrop-blur-sm md:px-6">
          <button
            class="flex size-8 items-center justify-center rounded-md text-muted-foreground hover:bg-muted hover:text-foreground md:hidden"
            onclick="openSidebar()"
            aria-label="Abrir menú"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
          </button>
          <a href="/" class="text-base font-bold tracking-tight md:hidden">
            Lara<span class="text-primary">Go</span>
          </a>
          <div class="flex-1"></div>
          <button
            onclick="toggleTheme()"
            class="flex size-8 items-center justify-center rounded-md text-muted-foreground hover:bg-muted hover:text-foreground"
            aria-label="Cambiar tema"
          >
            <svg id="sun-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden dark:block"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
            <svg id="moon-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="block dark:hidden"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
          </button>
        </header>

        <!-- Page content -->
        <main class="flex-1">
          <article class="prose prose-zinc mx-auto max-w-3xl px-4 py-8 dark:prose-invert md:px-6 md:py-10 lg:py-12">
            <slot />
          </article>
        </main>

        <!-- Footer -->
        <footer class="border-t border-border py-6 text-center text-xs text-muted-foreground">
          LaraGo &mdash; De Laravel a Go con la stdlib
        </footer>
      </div>
    </div>

    <style>
      /* Typography overrides for prose */
      .prose pre {
        background-color: hsl(var(--background));
        border: 1px solid hsl(var(--border));
        border-radius: var(--radius-lg);
        padding: 1rem;
        overflow-x: auto;
      }
      .prose code {
        font-size: 0.875em;
      }
      .prose pre code {
        font-size: 0.8em;
        background: none;
        padding: 0;
      }
      .prose :not(pre) > code {
        background: hsl(var(--muted));
        padding: 0.15em 0.4em;
        border-radius: var(--radius-sm);
        font-weight: 500;
      }
      .prose table {
        font-size: 0.875rem;
        border-collapse: collapse;
      }
      .prose th {
        background: hsl(var(--muted));
      }
      .prose blockquote {
        border-left-color: hsl(var(--primary));
        background: hsl(var(--muted) / 0.5);
        border-radius: 0 var(--radius-md) var(--radius-md) 0;
        padding: 0.75rem 1rem;
      }
      .prose blockquote p {
        margin: 0;
      }

      /* Shiki (astro-code) tweaks */
      .astro-code {
        background-color: hsl(var(--muted)) !important;
        border: 1px solid hsl(var(--border));
        border-radius: var(--radius-lg);
        padding: 1rem !important;
      }
    </style>

    <script>
      function openSidebar() {
        document.getElementById('mobile-sidebar').classList.remove('-translate-x-full');
        document.getElementById('sidebar-overlay').classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }

      function closeSidebar() {
        document.getElementById('mobile-sidebar').classList.add('-translate-x-full');
        document.getElementById('sidebar-overlay').classList.add('hidden');
        document.body.style.overflow = '';
      }

      function toggleTheme() {
        const html = document.documentElement;
        const isDark = html.classList.contains('dark');
        if (isDark) {
          html.classList.remove('dark');
          localStorage.setItem('theme', 'light');
        } else {
          html.classList.add('dark');
          localStorage.setItem('theme', 'dark');
        }
      }

      // Restore theme preference
      const savedTheme = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (savedTheme === 'light' || (!savedTheme && !prefersDark)) {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }
    </script>
  </body>
</html>
