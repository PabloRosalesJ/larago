---
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card"
import { Badge } from "@/components/ui/badge"
import { Separator } from "@/components/ui/separator"

interface Props {
  title: string
  description: string
  laravelUrl?: string
  goPackages?: string[]
  content: string
}

const { title, description, laravelUrl, goPackages, content } = Astro.props

function parseSections(md: string) {
  const sections: { level: number; title: string; content: string }[] = []
  const lines = md.split("\n")
  let current: { level: number; title: string; content: string } | null = null

  for (const line of lines) {
    const match = line.match(/^(#{1,3})\s+(.+)/)
    if (match) {
      if (current) sections.push(current)
      current = { level: match[1].length, title: match[2], content: "" }
    } else if (current) {
      current.content += line + "\n"
    }
  }
  if (current) sections.push(current)
  return sections
}

function renderInline(text: string) {
  return text
    .replace(/`([^`]+)`/g, '<code class="rounded bg-muted px-1.5 py-0.5 text-sm font-mono">$1</code>')
    .replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>")
    .replace(/\*([^*]+)\*/g, "<em>$1</em>")
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" class="text-primary underline underline-offset-4 hover:no-underline">$1</a>')
}

function renderBlock(text: string) {
  const lines = text.trim().split("\n")
  const html: string[] = []
  let inCode = false
  let codeLines: string[] = []

  for (const line of lines) {
    if (line.startsWith("```")) {
      if (inCode) {
        html.push(`<pre class="rounded-lg bg-muted p-4 overflow-x-auto text-sm"><code>${codeLines.join("\n").replace(/</g, "&lt;").replace(/>/g, "&gt;")}</code></pre>`)
        codeLines = []
        inCode = false
      } else {
        inCode = true
      }
    } else if (inCode) {
      codeLines.push(line)
    } else if (line.startsWith("- ")) {
      html.push(`<li class="ml-4 list-disc">${renderInline(line.slice(2))}</li>`)
    } else if (line.match(/^\d+\.\s/)) {
      html.push(`<li class="ml-4 list-decimal">${renderInline(line.replace(/^\d+\.\s/, ""))}</li>`)
    } else if (line.startsWith("|")) {
      // Table row - skip for now, will be handled in comparativa
    } else if (line.trim() === "---") {
      html.push(`<hr class="my-4" />`)
    } else if (line.trim()) {
      html.push(`<p class="mb-2">${renderInline(line)}</p>`)
    }
  }
  return html.join("\n")
}

const sections = parseSections(content)
---

<article class="flex flex-col gap-6">
  <div class="flex flex-col gap-2">
    <h1 class="text-3xl font-bold tracking-tight">{title}</h1>
    <p class="text-muted-foreground">{description}</p>
    {goPackages && goPackages.length > 0 && (
      <div class="flex gap-2 flex-wrap">
        {goPackages.map((pkg: string) => (
          <Badge variant="secondary">{pkg}</Badge>
        ))}
      </div>
    )}
  </div>

  <Separator />

  {sections.map((section, i) => (
    <Card>
      <CardHeader>
        <CardTitle>{section.title}</CardTitle>
      </CardHeader>
      <CardContent>
        <div set:html={renderBlock(section.content)} />
      </CardContent>
    </Card>
  ))}
</article>
