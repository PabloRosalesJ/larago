---
import { getCollection } from 'astro:content';
import { cleanSlug } from '../utils';

const allDocs = await getCollection('docs');

function getSection(id: string): string {
  const match = id.match(/^(\d{2}-[a-z-]+)-\d{2}-\d{2}-/);
  return match ? match[1] : '00-other';
}

const sections = new Map<string, typeof allDocs>();
for (const doc of allDocs) {
  const section = getSection(doc.id);
  if (!sections.has(section)) {
    sections.set(section, []);
  }
  sections.get(section)!.push(doc);
}

const sectionOrder = [
  '01-prologue', '02-getting-started', '03-architecture', '04-the-basics',
  '05-security', '06-database', '07-gorm', '08-sqlc', '09-comparativa',
  '10-digging-deeper', '11-testing', '12-contexto-laravel',
];

const sectionNames: Record<string, string> = {
  '01-prologue': 'Prólogo',
  '02-getting-started': 'Getting Started',
  '03-architecture': 'Arquitectura',
  '04-the-basics': 'The Basics',
  '05-security': 'Seguridad',
  '06-database': 'Database',
  '07-gorm': 'GORM',
  '08-sqlc': 'sqlc',
  '09-comparativa': 'Comparativa',
  '10-digging-deeper': 'Digging Deeper',
  '11-testing': 'Testing',
  '12-contexto-laravel': 'Contexto',
};

export interface Props {
  currentUrl: string;
}
const { currentUrl } = Astro.props;
---

{
  sectionOrder.filter(s => sections.has(s)).map(section => {
    const docs = sections.get(section)!;
    docs.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));
    return (
      <div class="mb-4">
        <h3 class="mb-1 px-2 text-[0.65rem] font-semibold uppercase tracking-widest text-sidebar-foreground/50">
          {sectionNames[section] || section}
        </h3>
        {docs.map(doc => {
          const href = `/${cleanSlug(doc.id)}/`;
          const isActive = currentUrl === href;
          return (
            <a
              href={href}
              class:list={[
                'flex items-center gap-2 rounded-md px-2 py-1.5 text-sm leading-tight transition-colors',
                isActive
                  ? 'bg-sidebar-accent font-medium text-sidebar-accent-foreground'
                  : 'text-sidebar-foreground/80 hover:bg-sidebar-accent/50 hover:text-sidebar-foreground',
              ]}
            >
              {doc.data.title}
            </a>
          );
        })}
      </div>
    );
  })
}
